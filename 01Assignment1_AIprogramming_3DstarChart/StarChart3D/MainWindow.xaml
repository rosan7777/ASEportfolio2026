<Window x:Class="StarChart3D.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StarChart3D"
        xmlns:h="http://helix-toolkit.org/wpf"
        mc:Ignorable="d"
        Title="Star Chart 3D" Height="800" Width="1200">
    <Grid>
        <!-- The 3D view of the star chart. Units are parsecs, with the Sun at (0,0,0).
             Mouse controls:
               mouse wheel          = zoom towards the point under the mouse cursor
               right mouse drag     = rotate
               Shift + right drag   = pan (middle mouse drag also pans, which is Helix's default)
             Inertia is off, so the view stops as soon as the mouse button is let go.
             The camera's position is shown in the bottom-left corner. -->
        <h:HelixViewport3D x:Name="StarViewport"
                           Background="Black"
                           ShowCoordinateSystem="True"
                           ShowViewCube="True"
                           ZoomAroundMouseDownPoint="True"
                           RotateGesture="RightClick"
                           PanGesture="Shift+RightClick"
                           IsInertiaEnabled="False"
                           ShowCameraInfo="True">

            <!-- Camera 30 parsecs from the Sun, looking straight at it.
                 The furthest star in stars.csv is about 20.5 parsecs away, so all stars fit in view. -->
            <h:HelixViewport3D.Camera>
                <PerspectiveCamera Position="0,0,30"
                                   LookDirection="0,0,-30"
                                   UpDirection="0,1,0"
                                   FieldOfView="60"
                                   NearPlaneDistance="0.01"
                                   FarPlaneDistance="1000" />
            </h:HelixViewport3D.Camera>

            <!-- Standard lighting so 3D shapes are visible. -->
            <h:DefaultLights />
        </h:HelixViewport3D>

        <!-- Controls panel in the top-left corner, drawn on top of the 3D view.
             A dark see-through background keeps the white text readable over the stars. -->
        <Border HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="10"
                Padding="8,4"
                Background="#B0202020"
                CornerRadius="4">
            <StackPanel>
                <CheckBox x:Name="ProperNameFilterCheckBox"
                          Content="Only show stars with a proper name"
                          Foreground="White"
                          IsChecked="False"
                          Focusable="False"
                          Checked="ProperNameFilterCheckBox_Changed"
                          Unchecked="ProperNameFilterCheckBox_Changed" />

                <!-- Feature 4: spaceship flight mode status (F turns it on and off). -->
                <TextBlock x:Name="FlightStatusText"
                           Foreground="LightGray"
                           FontSize="11"
                           Margin="0,4,0,0" />

                <!-- Feature 4: star search. Type part of a name; click a match (or press Enter for the
                     first one) to fly there. Esc clears the box. -->
                <TextBlock Text="Search stars:"
                           Foreground="White"
                           Margin="0,8,0,2" />
                <TextBox x:Name="SearchBox"
                         Width="260"
                         HorizontalAlignment="Left"
                         Background="#FF303030"
                         Foreground="White"
                         CaretBrush="White"
                         BorderBrush="Gray"
                         Padding="2"
                         TextChanged="SearchBox_TextChanged"
                         PreviewKeyDown="SearchBox_PreviewKeyDown" />
                <ListBox x:Name="SearchResultsList"
                         Width="260"
                         HorizontalAlignment="Left"
                         MaxHeight="300"
                         Margin="0,2,0,0"
                         Background="#F0101010"
                         BorderThickness="0"
                         Visibility="Collapsed"
                         SelectionChanged="SearchResultsList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding Name}"
                                           Foreground="White"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding RouteText}"
                                           Foreground="LightGray"
                                           FontSize="11" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- Feature 3: "Nearby stars" panel in the top-right corner, on top of the 3D view.
             Shows the current star and the 10 stars nearest to it, with distance, bearing and path.
             Clicking a star flies the camera to it. The background is almost solid so stars behind
             the panel don't make the text hard to read. -->
        <Border HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="10"
                Padding="10"
                Width="330"
                Background="#F0101010"
                CornerRadius="4">
            <StackPanel>
                <TextBlock Text="Nearby stars"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="Bold" />
                <TextBlock x:Name="CurrentStarText"
                           Foreground="LightGray"
                           Margin="0,4,0,8"
                           TextWrapping="Wrap" />
                <ListBox x:Name="NearbyStarsList"
                         Background="Transparent"
                         BorderThickness="0"
                         MaxHeight="520"
                         SelectionChanged="NearbyStarsList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding Name}"
                                           Foreground="White"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding RouteText}"
                                           Foreground="LightGray"
                                           FontSize="11" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- Feature 4: crosshair in the middle of the screen, shown only in flight mode.
             IsHitTestVisible="False" lets mouse clicks go through it to the 3D view. -->
        <Grid x:Name="Crosshair"
              Width="24"
              Height="24"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              IsHitTestVisible="False"
              Visibility="Collapsed">
            <Line X1="0" Y1="12" X2="9" Y2="12" Stroke="#FF7CFC9A" StrokeThickness="1.5" />
            <Line X1="15" Y1="12" X2="24" Y2="12" Stroke="#FF7CFC9A" StrokeThickness="1.5" />
            <Line X1="12" Y1="0" X2="12" Y2="9" Stroke="#FF7CFC9A" StrokeThickness="1.5" />
            <Line X1="12" Y1="15" X2="12" Y2="24" Stroke="#FF7CFC9A" StrokeThickness="1.5" />
        </Grid>

        <!-- Feature 4: cockpit HUD at the bottom centre, shown only in flight mode.
             Green monospaced text on an almost solid dark background, like a cockpit display. -->
        <Border x:Name="HudPanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="10,10,10,20"
                Padding="12,8"
                Background="#F0101010"
                BorderBrush="#FF7CFC9A"
                BorderThickness="1"
                CornerRadius="4"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="HudSpeedText" Foreground="#FF7CFC9A" FontFamily="Consolas" FontSize="14" />
                <TextBlock x:Name="HudHeadingText" Foreground="#FF7CFC9A" FontFamily="Consolas" FontSize="14" />
                <TextBlock x:Name="HudNearestText" Foreground="#FF7CFC9A" FontFamily="Consolas" FontSize="14" />
                <TextBlock x:Name="HudSunText" Foreground="#FF7CFC9A" FontFamily="Consolas" FontSize="14" />
                <TextBlock x:Name="HudTargetText" Foreground="#FFFFD86B" FontFamily="Consolas" FontSize="14" Margin="0,4,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>